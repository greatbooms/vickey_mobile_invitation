# Public origin for absolute Open Graph URLs.
VITE_SITE_URL=
# AMap Web (JS API) key.
VITE_AMAP_KEY=
# Production: own security proxy; this static project does not provide the server.
VITE_AMAP_SERVICE_HOST=
# Development alternative, exposed in the browser. Prefer proxy in production.
VITE_AMAP_SECURITY_CODE=

# Server-only: place these in .env.weather.local (never prefix with VITE_).
QWEATHER_API_HOST=
QWEATHER_API_KEY=
